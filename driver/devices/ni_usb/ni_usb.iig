#ifndef ni_usb_h
#define ni_usb_h

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <DriverKit/IOUserClient.iig>

class GPIBBoard;     // forward — defined in driver/core/GPIBBoard.h

class ni_usb: public IOService
{
public:
    virtual bool init() override;
    virtual void free() override;

    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;

    virtual kern_return_t NewUserClient(uint32_t type,
                                         IOUserClient ** userClient) override;

    // Local C++ accessor used by GPIBUserClient — both classes live in the
    // same dext process, so no IPC bridging is needed. LOCALONLY tells IIG
    // to keep the method in-process.
    virtual GPIBBoard * getBoard() LOCALONLY;
};

#endif /* ni_usb_h */
