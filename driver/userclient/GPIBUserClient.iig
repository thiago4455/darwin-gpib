//
//  GPIBUserClient.iig
//  darwin-gpib driver
//
//  IOUserClient subclass exposed by the ni_usb IOService. Hosts the
//  ExternalMethod dispatch table that the libgpib client library calls
//  into via IOConnectCallStructMethod / IOConnectCallScalarMethod.
//

#ifndef GPIBUserClient_h
#define GPIBUserClient_h

#include <Availability.h>
#include <DriverKit/IOUserClient.iig>

class GPIBBoard;   // forward — local-only pointer type, defined in driver/core/.

class GPIBUserClient: public IOUserClient
{
public:
    virtual bool init() override;
    virtual void free() override;

    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;

    // LOCAL — the framework dispatches into ExternalMethod inside the dext
    // process via a regular C++ vcall, so IIG does not need to generate
    // cross-process bridging machinery. We implement it as a plain method
    // (no IMPL macro) in GPIBUserClient.cpp.
    virtual kern_return_t ExternalMethod(
        uint64_t selector,
        IOUserClientMethodArguments * arguments,
        const IOUserClientMethodDispatch * dispatch,
        OSObject * target,
        void * reference) LOCAL override;

    // Accessor for the per-instance board pointer used by the static
    // selector handlers. LOCALONLY keeps it private to the dext process.
    virtual GPIBBoard * boardForDispatch() LOCALONLY;
};

#endif /* GPIBUserClient_h */
